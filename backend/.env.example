# ── Core ──
NODE_ENV=development
PORT=3001
PUBLIC_URL=http://localhost:5173         # frontend origin (used in QR links & OAuth redirects)
API_URL=http://localhost:3001
# Comma-separated allowed CORS origins (production). Empty = allow all (dev only).
CORS_ORIGIN=
# Reverse-proxy hops to trust for the client IP (rate limiting / audit). Set to
# your infra's hop count (e.g. 1 behind one load balancer). Empty/false = trust
# none (app directly exposed). Never leave X-Forwarded-For trusted by accident.
TRUST_PROXY=

# ── Database (Postgres) ──
DATABASE_URL=postgres://user:pass@host:5432/vau
# Max Postgres pool connections per instance (keep under the provider's cap).
DB_POOL_MAX=10

# ── Secrets (set strong random values in production) ──
JWT_SECRET=change-me-to-a-long-random-string
VOUCHER_SECRET=change-me-to-a-different-long-random-string
# Protects the /api/admin/* CRM back-office endpoints. Leave blank to disable
# the admin API entirely (recommended until you set a strong random value).
ADMIN_TOKEN=
# Version stamped onto recorded consents; bump when Terms/Privacy text changes.
POLICY_VERSION=2026-08
# Hold new customer reviews as 'pending' for admin approval before they show.
REVIEW_MODERATION=false

# ── Sign in with Google (leave blank for demo login) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# ── Sign in with Apple (leave blank for demo login) ──
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:3001/api/auth/apple/callback

# ── Payment gateway ──
# provider: mock (default, no keys) | stripe
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=ILS
# Stripe supports Visa/Mastercard + Apple Pay + Google Pay via PaymentIntents.
# For an Israeli PSP (Tranzila, Cardcom, PayPlus, Meshulam), add a sibling
# adapter in payments.js implementing the same 3 methods.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── E-voucher email delivery ──
# transport: log (default, prints to console) | brevo | smtp
#   brevo -> reuses BREVO_API_KEY below (Brevo transactional email API).
#            The EMAIL_FROM address/domain must be verified in your Brevo account.
EMAIL_TRANSPORT=log
EMAIL_FROM=VAU <no-reply@vau.co.il>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── CRM / marketing platform ──
# Our Postgres is always the system of record for customers, orders & consent.
# This mirrors those into an external CRM/ESP for campaigns & segmentation.
# provider: log (default, no keys — prints intended syncs) | brevo | hubspot | activetrail
CRM_PROVIDER=log
# Brevo (ex-Sendinblue) — recommended starter: email marketing + light CRM.
BREVO_API_KEY=
BREVO_LIST_ID=
# HubSpot — private-app token if you prefer HubSpot CRM.
HUBSPOT_TOKEN=
# ActiveTrail — Israeli email/SMS platform, native Hebrew/RTL. Token from the
# ActiveTrail web UI (Settings -> API apps). GROUP_ID = the marketing list that
# opted-in contacts are added to.
ACTIVETRAIL_TOKEN=
ACTIVETRAIL_GROUP_ID=

# ── AI gift assistant (Anthropic Claude) ──
# With a key the assistant uses Claude; without it, a deterministic recommender.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5

# ── Fraud / anti-abuse ──
# Gift vouchers must be valid ≥5 years under Israeli Consumer Protection Law.
VOUCHER_VALIDITY_DAYS=1826
MAX_ACTIVATION_ATTEMPTS=10
