# ─────────────────────────────────────────────────────────────────────────
# VAU backend — PRODUCTION environment template for vaugift.com
# Copy to your host's secret store (Render dashboard / Railway variables / etc).
# NEVER commit the filled-in version. Values left blank keep that provider in a
# safe fallback mode (the app still boots and never fakes success).
# ─────────────────────────────────────────────────────────────────────────

# ── Core ──
NODE_ENV=production
PORT=3001
PUBLIC_URL=https://vaugift.com                 # frontend origin (QR links, OAuth redirects)
API_URL=https://api.vaugift.com
CORS_ORIGIN=https://vaugift.com,https://www.vaugift.com
TRUST_PROXY=1                                   # 1 reverse-proxy hop (Render/Railway/most PaaS)

# ── Database (managed Postgres) ──
DATABASE_URL=postgres://USER:PASS@HOST:5432/vau
DB_POOL_MAX=10

# ── Secrets — MUST be long random strings in production ──
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM
VOUCHER_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM
ADMIN_TOKEN=                                     # optional break-glass token for /api/admin/*

# ── First admin (auto-created on first boot) ──
ADMIN_EMAIL=admin@vaugift.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
ADMIN_PHONE=+9725XXXXXXXX                        # E.164 — enables SMS account recovery

# ── SMS (admin recovery codes) ──
SMS_PROVIDER=brevo                               # brevo reuses BREVO_API_KEY | twilio | log
SMS_SENDER=VAU
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

POLICY_VERSION=2026-08
REVIEW_MODERATION=true                            # hold new reviews for admin approval

# ── Sign in with Google (optional — blank = one-tap demo login stays off in prod) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.vaugift.com/api/auth/google/callback

# ── Sign in with Apple (optional) ──
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=https://api.vaugift.com/api/auth/apple/callback

# ── Payment gateway ──
# Start on mock to smoke-test, switch to stripe once the keys + webhook are live.
# For an Israeli PSP (Tranzila / Cardcom / PayPlus / Meshulam) add a sibling
# adapter in payments.js implementing createPayment/getPayment/verifyWebhook.
PAYMENT_PROVIDER=stripe
PAYMENT_CURRENCY=ILS
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...                   # from the Stripe webhook → https://api.vaugift.com/api/payments/webhook

# ── E-voucher email (Brevo transactional) ──
# The EMAIL_FROM domain (vaugift.com) MUST be verified in Brevo (SPF/DKIM) first.
EMAIL_TRANSPORT=brevo                             # brevo | smtp | log
EMAIL_FROM=VAU <no-reply@vaugift.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── CRM / marketing mirror ──
CRM_PROVIDER=brevo                                # brevo | hubspot | activetrail | log
BREVO_API_KEY=xkeysib-ROTATED_KEY                 # ⚠ rotate the previously shared key
BREVO_LIST_ID=                                    # marketing list opted-in contacts join
HUBSPOT_TOKEN=
ACTIVETRAIL_TOKEN=
ACTIVETRAIL_GROUP_ID=

# ── AI gift assistant ──
ANTHROPIC_API_KEY=                                # blank = deterministic rule-based recommender
ASSISTANT_MODEL=claude-opus-5

# ── Bot protection (Cloudflare Turnstile) ──
# Blank secret = gate OFF (no human-check on checkout/admin login). Set the
# secret here and the matching public site key as VITE_TURNSTILE_SITE_KEY on the
# frontend build to turn it on.
TURNSTILE_SECRET_KEY=                              # blank = bot gate off
TURNSTILE_SITE_KEY=                               # optional here; the public key the SPA uses is VITE_TURNSTILE_SITE_KEY

# ── Fraud / anti-abuse ──
VOUCHER_VALIDITY_DAYS=365                          # 12 months (see config.js note on the 5-year legal minimum)
MAX_ACTIVATION_ATTEMPTS=10
