# Frontend production build config (picked up automatically by `vite build`).
# VITE_ vars are baked into the bundle at build time, so this must be correct
# BEFORE building. Override in the host's build env if the API lives elsewhere.

# The backend API base (note the trailing /api).
VITE_API_URL=https://api.vaugift.com/api

# Leave unset for the real site. VITE_DEMO=1 builds the self-contained,
# backend-less demo (used for the shareable preview artifact only).
# VITE_DEMO=
